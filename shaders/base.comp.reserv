#version 460 core

layout (local_size_x = 16, local_size_y = 16) in;

layout (rgba32f, binding = 0) uniform image2D destTex;
layout (r32f,  binding = 1) uniform image2D hbaoTex;

uniform vec2  uResolution;
uniform vec3  uCamPos;
uniform vec3  uCamTarg;
uniform vec3  uCamUp;
uniform float uCamFov;

struct Vertex {
    vec4 pos;
    vec4 normal;
    vec2 uv;
    vec2 pad;
};

layout(std430, binding = 0) buffer VertexBuffer {
    Vertex vertices[];
};

layout(std430, binding = 1) buffer IndexBuffer {
    uint indices[];
};

// ------------------------------------------------------------
// Triangle intersection (Möller–Trumbore)
// ------------------------------------------------------------
bool intersectTriangle(
vec3 ro, vec3 rd,
vec3 v0, vec3 v1, vec3 v2,
vec3 n0, vec3 n1, vec3 n2,
out float t, out vec3 n)
{
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;

    vec3 p = cross(rd, e2);
    float det = dot(e1, p);
    if(abs(det) < 1e-6) return false;

    float invDet = 1.0 / det;
    vec3 s = ro - v0;

    float u = dot(s, p) * invDet;
    if(u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, e1);
    float v = dot(rd, q) * invDet;
    if(v < 0.0 || u + v > 1.0) return false;

    t = dot(e2, q) * invDet;
    if(t <= 0.0) return false;

    float w = 1.0 - u - v;
    n = normalize(w*n0 + u*n1 + v*n2);

    return true;
}

// ------------------------------------------------------------
// Simple hash
// ------------------------------------------------------------
float rand(vec2 co)
{
    return fract(sin(dot(co, vec2(12.9898,78.233))) * 43758.5453);
}

// ------------------------------------------------------------
// Hemisphere sampling (correct TBN)
// ------------------------------------------------------------
vec3 SampleHemisphere(vec3 N, vec2 seed)
{
    float phi = seed.x * 6.2831853;
    float cosTheta = seed.y;
    float sinTheta = sqrt(1.0 - cosTheta*cosTheta);

    vec3 localDir = vec3(
    cos(phi)*sinTheta,
    sin(phi)*sinTheta,
    cosTheta
    );

    vec3 T = normalize(abs(N.x) > 0.1 ?
    cross(vec3(0,1,0), N) :
    cross(vec3(1,0,0), N));
    vec3 B = cross(N, T);

    return normalize(T*localDir.x +
    B*localDir.y +
    N*localDir.z);
}

// ------------------------------------------------------------
// MAIN
// ------------------------------------------------------------
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if(pixel.x >= int(uResolution.x) ||
    pixel.y >= int(uResolution.y)) return;

    vec2 uv = (vec2(pixel)/uResolution)*2.0 - 1.0;
    uv.x *= uResolution.x/uResolution.y;

    vec3 forward = normalize(uCamTarg - uCamPos);
    vec3 right   = normalize(cross(forward, uCamUp));
    vec3 up      = cross(right, forward);

    float fovScale = tan(radians(uCamFov)*0.5);

    vec3 ro = uCamPos;
    vec3 rd = normalize(uv.x*fovScale*right +
    uv.y*fovScale*up +
    forward);

    // --------------------------------------------------------
    // First hit
    // --------------------------------------------------------
    float closestT = 1e30;
    vec3 hitPos = vec3(0);
    vec3 hitN   = vec3(0);
    bool hit = false;

    uint triCount = indices.length()/3;

    for(uint t=0; t<triCount; t++)
    {
        uint i0 = indices[t*3+0];
        uint i1 = indices[t*3+1];
        uint i2 = indices[t*3+2];

        float dist;
        vec3 n;

        if(intersectTriangle(
        ro, rd,
        vertices[i0].pos.xyz,
        vertices[i1].pos.xyz,
        vertices[i2].pos.xyz,
        vertices[i0].normal.xyz,
        vertices[i1].normal.xyz,
        vertices[i2].normal.xyz,
        dist, n))
        {
            if(dist < closestT)
            {
                closestT = dist;
                hitPos = ro + rd*dist;
                hitN = n;
                hit = true;
            }
        }
    }

    float mask = 0.0;

    // --------------------------------------------------------
    // Second bounce (AO test)
    // --------------------------------------------------------
    if(hit)
    {
        int sampleCount = 4;
        float radius = 0.25;
        float occlusion = 0.0;

        for(int i=0;i<sampleCount;i++)
        {
            vec2 seed = vec2(
            rand(hitPos.xy + float(i)*0.37),
            rand(hitPos.yz + float(i)*0.91)
            );

            vec3 dir = SampleHemisphere(hitN, seed);
            vec3 origin = hitPos + hitN * 0.01;

            for(uint t=0;t<triCount;t++) {
                uint i0 = indices[t*3+0];
                uint i1 = indices[t*3+1];
                uint i2 = indices[t*3+2];

                float dist2;
                vec3 n2;

                if(intersectTriangle(origin, dir,vertices[i0].pos.xyz,vertices[i1].pos.xyz,vertices[i2].pos.xyz,vertices[i0].normal.xyz,vertices[i1].normal.xyz,vertices[i2].normal.xyz,dist2, n2)) {
                    if(dist2 < radius && dot(n2, -dir) > 0.2) {
                        occlusion += 1.0;
                        break;
                    }
                }
            }
        }

        mask = occlusion / float(sampleCount);
    }

    imageStore(hbaoTex, pixel, vec4(mask,0,0,1));
    imageStore(destTex, pixel, vec4(mask,mask,mask,1));
}