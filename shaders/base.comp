#version 460 core

layout (local_size_x = 16, local_size_y = 16) in;
layout (rgba32f, binding = 0) uniform image2D destTex;

uniform vec2 uResolution;
uniform vec3 uCamPos;
uniform mat3 uCamRot;

struct Vertex {
    vec4 pos;
    vec4 normal;
    vec2 uv;
    vec2 pad;
};

layout(std430, binding = 0) buffer VertexBuffer {
    Vertex vertices[];
};

layout(std430, binding = 1) buffer IndexBuffer {
    uint indices[];
};

bool intersectTriangle(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, out float t, out vec3 n){
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;

    vec3 p = cross(rd, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-6) return false;

    float invDet = 1.0 / det;
    vec3 s = ro - v0;

    float u = dot(s, p) * invDet;
    if (u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, e1);
    float v = dot(rd, q) * invDet;
    if (v < 0.0 || u + v > 1.0) return false;

    t = dot(e2, q) * invDet;
    if (t <= 0.0) return false;

    n = normalize(cross(e1, e2));
    return true;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(uResolution.x) ||
    pixel.y >= int(uResolution.y))
    return;

    vec2 uv = (vec2(pixel) / uResolution) * 2.0 - 1.0;
    uv.x *= uResolution.x / uResolution.y;

    vec3 ro = uCamPos;
    vec3 rd = normalize(uCamRot * vec3(uv, -1.0));

    float closestT = 1e30;
    vec3 hitNormal = vec3(0.0);
    bool hit = false;

    uint triCount = indices.length() / 3;

    for (uint t = 0; t < triCount; ++t) {
        uint i0 = indices[t * 3 + 0];
        uint i1 = indices[t * 3 + 1];
        uint i2 = indices[t * 3 + 2];

        vec3 v0 = vertices[i0].pos.xyz;
        vec3 v1 = vertices[i1].pos.xyz;
        vec3 v2 = vertices[i2].pos.xyz;

        float dist;
        vec3 n;

        if (intersectTriangle(ro, rd, v0, v1, v2, dist, n)) {
            if (dist < closestT) {
                closestT = dist;
                hitNormal = n;
                hit = true;
            }
        }
    }
    vec3 color = vec3(0.0);
    if (hit) {
        vec3 lightDir = normalize(vec3(0.5, 1.0, -0.3));
        float diff = max(dot(hitNormal, lightDir), 0.0);
        color = vec3(diff);
    }
    imageStore(destTex, pixel, vec4(color, 1.0));
}