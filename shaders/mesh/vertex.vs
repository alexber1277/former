#version 460 core
out vec2 uv;

void main() {
    // Вершины для двух треугольников, образующих полноэкранный прямоугольник
    // Оба треугольника с порядком вершин ПРОТИВ часовой стрелки (CCW)
    vec2 positions[6] = vec2[](
        // Первый треугольник (левая нижняя половина) - CCW
        vec2(-1.0, -1.0),  // левый нижний
        vec2( 1.0, -1.0),  // правый нижний
        vec2(-1.0,  1.0),  // левый верхний

        // Второй треугольник (правая верхняя половина) - CCW
        vec2( 1.0, -1.0),  // правый нижний
        vec2( 1.0,  1.0),  // правый верхний
        vec2(-1.0,  1.0)   // левый верхний
    );

    // Соответствующие UV координаты для текстурирования
    vec2 uvs[6] = vec2[](
        // UV для первого треугольника
        vec2(0.0, 0.0),  // левый нижний
        vec2(1.0, 0.0),  // правый нижний
        vec2(0.0, 1.0),  // левый верхний

        // UV для второго треугольника
        vec2(1.0, 0.0),  // правый нижний
        vec2(1.0, 1.0),  // правый верхний
        vec2(0.0, 1.0)   // левый верхний
    );

    uv = uvs[gl_VertexID];
    gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
}